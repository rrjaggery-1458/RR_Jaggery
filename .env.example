# Database Configuration (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rr_jaggery_db
DB_USER=postgres
DB_PASSWORD=postgres_dev_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & Authentication Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# Service Port Allocations
AUTH_SERVICE_PORT=8081
COMMERCE_SERVICE_PORT=8082
CUSTOMER_LEDGER_SERVICE_PORT=8083
INVENTORY_SERVICE_PORT=8084
PROCUREMENT_SERVICE_PORT=8085
PRODUCTION_SERVICE_PORT=8086
FINANCE_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088

# Application Profiles & Host Ingress
SPRING_PROFILES_ACTIVE=dev
VITE_API_BASE_URL=http://localhost:8080/api/v1
APP_BASE_URL=http://localhost:3000

# Automated Backups
BACKUP_DIR=/var/backups/rr-jaggery
RETENTION_DAYS=14
