# ==============================================================================
# RR JAGGERY TRADERS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' on your deployment environment and populate actual values.
# IMPORTANT: DO NOT commit actual secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rr_jaggery_db
# Superuser / Administrative User (Used for schema creation, migrations, and maintenance only)
DB_USER=postgres
# In development: postgres_dev_password
# In production: Generate a strong, random 32+ character alphanumeric password
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Hibernate DDL Mode
# In development: update
# In production: validate (enforced by compose.production.yaml; fail-closed)
HIBERNATE_DDL_AUTO=validate

# ------------------------------------------------------------------------------
# 2. RUNTIME SERVICE DATABASE ROLES (Least Privilege)
# ------------------------------------------------------------------------------
# In production, each microservice connects using its own dedicated, unprivileged role.
# Passwords must be provisioned via infrastructure/docker/postgres/provision_runtime_roles.sh (or .ps1)
# before starting services with compose.production.yaml.

RR_AUTH_DB_USER=rr_auth
RR_AUTH_DB_PASSWORD=GENERATE_STRONG_RANDOM_ROLE_PASSWORD

RR_COMMERCE_DB_USER=rr_commerce
RR_COMMERCE_DB_PASSWORD=GENERATE_STRONG_RANDOM_ROLE_PASSWORD

RR_CUSTFIN_DB_USER=rr_custfin
RR_CUSTFIN_DB_PASSWORD=GENERATE_STRONG_RANDOM_ROLE_PASSWORD

RR_INVPROC_DB_USER=rr_invproc
RR_INVPROC_DB_PASSWORD=GENERATE_STRONG_RANDOM_ROLE_PASSWORD

RR_PRODUCTION_DB_USER=rr_production
RR_PRODUCTION_DB_PASSWORD=GENERATE_STRONG_RANDOM_ROLE_PASSWORD


# ------------------------------------------------------------------------------
# 3. JWT & AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit (64 hex characters) secret:
# Example generation: openssl rand -hex 32
JWT_SECRET=GENERATE_64_CHAR_HEX_SECRET_openssl_rand_hex_32
# Access token expiration in milliseconds (900000 = 15 minutes)
JWT_EXPIRATION_MS=900000
# Refresh token expiration in milliseconds (604800000 = 7 days)
REFRESH_TOKEN_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 4. FIRST ADMIN ACCOUNT BOOTSTRAP
# ------------------------------------------------------------------------------
# Used ONLY on initial startup if no enabled ADMIN account exists in the database.
# Fails closed if left blank when no ADMIN exists.
BOOTSTRAP_ADMIN_USERNAME=admin@rrjaggery.com
BOOTSTRAP_ADMIN_PASSWORD=GENERATE_STRONG_16_CHAR_ADMIN_PASSWORD

# ------------------------------------------------------------------------------
# 5. DOMAIN & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# TEMPORARY TESTING DOMAIN: rrdentalneeds.online
# FUTURE PERMANENT DOMAIN:  rrjaggery.com
#
# To switch domains later, change ONLY these two variables.
# Do NOT hardcode domain names in application source code.
#
# Testing / initial deployment:
PRODUCTION_DOMAIN=rrdentalneeds.online
ALLOWED_ORIGINS=https://rrdentalneeds.online,https://www.rrdentalneeds.online

# When switching to the permanent domain, change the above two lines to:
# PRODUCTION_DOMAIN=rrjaggery.com
# ALLOWED_ORIGINS=https://rrjaggery.com,https://www.rrjaggery.com

# Frontend API base URL (Vite build-time variable — PUBLIC, must not include secrets)
# For testing domain:
VITE_API_BASE_URL=https://rrdentalneeds.online/api
# For permanent domain, change to: https://rrjaggery.com/api

# Frontend public domain (used for canonical URL, meta tags)
VITE_PUBLIC_DOMAIN=rrdentalneeds.online

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY — RAZORPAY
# ------------------------------------------------------------------------------
# STATUS: Integration architecture prepared. Credentials NOT yet configured.
# Obtain credentials from your Razorpay Dashboard: https://dashboard.razorpay.com/
#
# DO NOT put real credentials here. Add them ONLY on the production server via .env.
# RAZORPAY_KEY_ID = public key (safe to expose to frontend via VITE_ prefix)
# RAZORPAY_KEY_SECRET = private signing key — MUST NEVER reach the frontend or logs
# RAZORPAY_WEBHOOK_SECRET = used to verify webhook HMAC signatures server-side only
#
RAZORPAY_KEY_ID=PENDING_FROM_BUSINESS_OWNER
RAZORPAY_KEY_SECRET=PENDING_FROM_BUSINESS_OWNER
RAZORPAY_WEBHOOK_SECRET=PENDING_FROM_BUSINESS_OWNER

# Set to 'true' ONLY after real credentials are configured and payment flow tested
RAZORPAY_ENABLED=false

# Public Razorpay key exposed to frontend (safe — it is the publishable key only)
# Copy value from RAZORPAY_KEY_ID above:
VITE_RAZORPAY_KEY_ID=PENDING_FROM_BUSINESS_OWNER

# ------------------------------------------------------------------------------
# 7. PUBLIC WEBSITE CONTACT FORM EMAIL (customer-finance-service)
# ------------------------------------------------------------------------------
# Configure with SMTP credentials for your mail provider. For Gmail, use
# smtp.gmail.com:587 and an app password (not your account password).
# These values remain server-side and must never be added to VITE_* variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
# Defaults to SMTP_USERNAME when omitted; choose a provider-approved sender.
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_RECIPIENT=rrjaggery@gmail.com

# ------------------------------------------------------------------------------
# 8. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# Profile: 'dev' for local Docker compose; 'prod' for production compose
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 9. INTERNAL SERVICE PORTS (Docker Bridge Network - 5 Consolidated Services)
# ------------------------------------------------------------------------------
AUTH_SERVICE_PORT=8081
COMMERCE_SERVICE_PORT=8082
CUSTOMER_FINANCE_SERVICE_PORT=8083
INVENTORY_PROCUREMENT_SERVICE_PORT=8084
PRODUCTION_SERVICE_PORT=8086

# ------------------------------------------------------------------------------
# 10. AUTOMATED BACKUPS & RETENTION
# ------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/rr-jaggery
RETENTION_DAYS=14

# ------------------------------------------------------------------------------
# CRITICAL NOTES
# ------------------------------------------------------------------------------
# 1. VITE_* variables are baked into the browser bundle — they are PUBLIC.
#    Never put passwords, JWT secrets, or private API keys in VITE_* variables.
#    RAZORPAY_KEY_ID (public key only) MAY be in VITE_ — KEY_SECRET MUST NOT.
#
# 2. RAZORPAY_ENABLED=false is the safe default. Payments fall back to COD
#    until real credentials are provided and the payment flow is fully tested.
#
# 3. To change production domain from rrdentalneeds.online to rrjaggery.com later,
#    edit ONLY: PRODUCTION_DOMAIN, ALLOWED_ORIGINS, VITE_API_BASE_URL, VITE_PUBLIC_DOMAIN.
#    No application source code changes are needed.
# ------------------------------------------------------------------------------
